<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- `dotnet publish -t:PublishContainer` builds this image, with no Dockerfile. It runs as a user without root. -->
    <ContainerRepository>overens-migrate</ContainerRepository>
  </PropertyGroup>

  <!-- Applies the database schema and gives the run-time roles their passwords, then exits. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Data\Overens.Data.csproj" />
  </ItemGroup>

</Project>
