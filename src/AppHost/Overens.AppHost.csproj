<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Runs with plain `dotnet run`: nothing to install beyond the .NET SDK and Docker. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Overens.Api.csproj" />
    <ProjectReference Include="..\Worker\Overens.Worker.csproj" />
    <ProjectReference Include="..\..\tools\Migrate\Overens.Migrate.csproj" />
  </ItemGroup>

</Project>
