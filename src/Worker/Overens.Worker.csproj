<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- `dotnet publish -t:PublishContainer` builds this image, with no Dockerfile. It runs as a user without root. -->
    <ContainerRepository>overens-worker</ContainerRepository>
  </PropertyGroup>

  <!-- Runs the ingestion pipeline as a durable orchestration. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.DurableTask.Client.AzureManaged" />
    <PackageReference Include="Microsoft.DurableTask.Worker.AzureManaged" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gateway\Overens.Gateway.csproj" />
    <ProjectReference Include="..\Ingestion\Overens.Ingestion.csproj" />
    <ProjectReference Include="..\ServiceDefaults\Overens.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
